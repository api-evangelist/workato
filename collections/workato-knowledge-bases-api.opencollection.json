{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workato Agent Studio Data Tables Knowledge Bases API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Knowledge Bases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Workato List Knowledge Bases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.workato.com/api/agentic/knowledge_bases",
            "params": [
              {
                "name": "folder_id",
                "value": "",
                "type": "query",
                "description": "Filter results by folder ID."
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Filter results by project ID."
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search query to filter results by name."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-based)."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              },
              {
                "name": "sort_term",
                "value": "",
                "type": "query",
                "description": "Field to sort results by."
              }
            ]
          },
          "docs": "Returns a paginated list of knowledge bases in the workspace. Knowledge bases provide AI agents with contextual data from configured data sources."
        },
        {
          "info": {
            "name": "Workato Create a Knowledge Base",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.workato.com/api/agentic/knowledge_bases",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new knowledge base with the specified name, description, source type, and data sources for use by AI agents."
        },
        {
          "info": {
            "name": "Workato Get a Knowledge Base",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.workato.com/api/agentic/knowledge_bases/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge base."
              }
            ]
          },
          "docs": "Returns the details of a specific knowledge base by its ID."
        },
        {
          "info": {
            "name": "Workato Update a Knowledge Base",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.workato.com/api/agentic/knowledge_bases/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge base."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the configuration of an existing knowledge base."
        },
        {
          "info": {
            "name": "Workato Delete a Knowledge Base",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.workato.com/api/agentic/knowledge_bases/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge base."
              }
            ]
          },
          "docs": "Permanently deletes a knowledge base from the workspace."
        },
        {
          "info": {
            "name": "Workato List Knowledge Base Data Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.workato.com/api/agentic/knowledge_bases/:id/data_sources",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge base."
              }
            ]
          },
          "docs": "Returns all data sources configured for a specific knowledge base, including source type and connection details."
        },
        {
          "info": {
            "name": "Workato List Recipes in a Knowledge Base",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.workato.com/api/agentic/knowledge_bases/:id/recipes",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge base."
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search query to filter results by name."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-based)."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              },
              {
                "name": "sort_term",
                "value": "",
                "type": "query",
                "description": "Field to sort results by."
              }
            ]
          },
          "docs": "Returns a paginated list of recipes associated with a specific knowledge base."
        }
      ]
    }
  ],
  "bundled": true
}