{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workato Agent Studio Data Tables User Groups API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Workato Assign User Groups to an MCP Server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.workato.com/api/mcp/mcp_servers/:handle/assign_user_groups",
            "params": [
              {
                "name": "handle",
                "value": "",
                "type": "path",
                "description": "Unique handle (slug) of the MCP server."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Assigns identity provider user groups to an MCP server to control which users can access it."
        },
        {
          "info": {
            "name": "Workato Remove User Groups from an MCP Server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.workato.com/api/mcp/mcp_servers/:handle/remove_user_groups",
            "params": [
              {
                "name": "handle",
                "value": "",
                "type": "path",
                "description": "Unique handle (slug) of the MCP server."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Removes identity provider user groups from an MCP server."
        },
        {
          "info": {
            "name": "Workato List User Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.workato.com/api/mcp/user_groups",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-based)."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              }
            ]
          },
          "docs": "Returns a list of identity provider user groups available for MCP server assignment."
        }
      ]
    }
  ],
  "bundled": true
}