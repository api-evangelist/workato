                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the genie."
              }
            ]
          },
          "docs": "Activates an AI agent (genie), making it available to handle requests."
        },
        {
          "info": {
            "name": "Workato Stop a Genie",
            "type": "http"
