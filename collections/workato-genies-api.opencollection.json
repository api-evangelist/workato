{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workato Agent Studio Data Tables Genies API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
